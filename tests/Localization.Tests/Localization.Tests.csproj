<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Localization/LocalizationManager.cs" Link="LocalizationManager.cs" />
    <EmbeddedResource Include="../../Resources/Strings/*.json"
                      LogicalName="AIUsageMonitor.Resources.Strings.%(Filename)%(Extension)"
                      WithCulture="false" />
  </ItemGroup>
</Project>
