<?xml version="1.0" encoding="utf-8" ?>
<views:MainPageTabView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:AIUsageMonitor.Localization"
             xmlns:local="clr-namespace:AIUsageMonitor"
             xmlns:views="clr-namespace:AIUsageMonitor.Views"
             x:Class="AIUsageMonitor.Views.AboutTabView" x:Name="TabRoot" x:DataType="local:MainPage">
        <ScrollView IsVisible="{Binding IsAboutTab}" Padding="20">
            <VerticalStackLayout Spacing="20" MaximumWidthRequest="600" HorizontalOptions="Center">
                <!-- Title -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="AIUsageMonitor" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource Slate50}" />
                    <Label Text="{Binding AboutVersionLabel}" FontSize="12" TextColor="{StaticResource Slate500}" />
                </VerticalStackLayout>

                <BoxView HeightRequest="1" BackgroundColor="{StaticResource Slate700}" />

                <!-- Getting Started -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="{loc:Loc Key=about.getting_started}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Emerald500}" CharacterSpacing="1" />
                    <Label Text="{loc:Loc Key=about.getting_started_detail}"
                           FontSize="13" TextColor="{StaticResource Slate400}" LineHeight="1.5" />
                </VerticalStackLayout>

                <!-- Antigravity Setup -->
                <Border BackgroundColor="{StaticResource Slate800}" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="{StaticResource Slate700}" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="G" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Emerald500}" VerticalOptions="Center" />
                            <Label Text="{loc:Loc Key=about.antigravity}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Slate100}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label FontSize="12" TextColor="{StaticResource Slate400}" LineHeight="1.5"
                               Text="{loc:Loc Key=about.antigravity_steps}" />
                        <Label Text="{loc:Loc Key=about.antigravity_models}"
                               FontSize="10" TextColor="{StaticResource Slate500}" FontAttributes="Italic" />
                    </VerticalStackLayout>
                </Border>

                <!-- Codex Setup -->
                <Border BackgroundColor="{StaticResource Slate800}" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="{StaticResource Slate700}" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="C" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Emerald500}" VerticalOptions="Center" />
                            <Label Text="{loc:Loc Key=about.codex}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Slate100}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label FontSize="12" TextColor="{StaticResource Slate400}" LineHeight="1.5"
                               Text="{loc:Loc Key=about.codex_steps}" />
                        <HorizontalStackLayout Spacing="4" Margin="0,4,0,0">
                            <Label Text="→" FontSize="12" TextColor="{StaticResource Sky400}" VerticalOptions="Center" />
                            <Label Text="https://openai.com/codex" FontSize="11" Style="{StaticResource LinkLabelStyle}" VerticalOptions="Center" ToolTipProperties.Text="{loc:Loc Key=about.open_codex_website}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnOpenCodexSiteClicked" />
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Notes -->
                <Border BackgroundColor="#1a7dd3fc" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="14">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{loc:Loc Key=about.tips}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Sky400}" />
                        <Label FontSize="11" TextColor="{StaticResource Slate400}" LineHeight="1.5"
                               Text="{loc:Loc Key=about.tips_detail}" />
                    </VerticalStackLayout>
                </Border>

                <HorizontalStackLayout Spacing="10">
                    <Button Text="{loc:Loc Key=about.github_source}"
                            Clicked="OnOpenGitHubSourceClicked"
                            Style="{StaticResource UtilityButtonStyle}"
                            Padding="20,0"
                            HeightRequest="36"
                            HorizontalOptions="Start" />
                    <Button Text="{loc:Loc Key=about.github_releases}"
                            Clicked="OnOpenGitHubReleasesClicked"
                            Style="{StaticResource UtilityButtonStyle}"
                            Padding="20,0"
                            HeightRequest="36"
                            HorizontalOptions="Start" />
                </HorizontalStackLayout>

                <Label Text="{loc:Loc Key=about.footer}" FontSize="10" TextColor="{StaticResource Slate600}" HorizontalOptions="Center" Margin="0,10,0,30" />
            </VerticalStackLayout>
        </ScrollView>
</views:MainPageTabView>
