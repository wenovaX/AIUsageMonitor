<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:AIUsageMonitor.Models"
             xmlns:converters="clr-namespace:AIUsageMonitor.Converters"
             xmlns:controls="clr-namespace:AIUsageMonitor.Controls"
             xmlns:loc="clr-namespace:AIUsageMonitor.Localization"
             xmlns:local="clr-namespace:AIUsageMonitor"
             xmlns:h="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Maui"
             x:Class="AIUsageMonitor.MainPage"
             x:DataType="local:MainPage"
             BackgroundColor="{StaticResource Slate900}"
             Title="">



    <Grid ColumnDefinitions="80, *">
        <!-- System Tray Icon -->
        <h:TaskbarIcon x:Name="TrayIcon"
                       ToolTipText="AIUsageMonitor"
                       MenuActivation="RightClick"
                       NoLeftClickDelay="True"
                       DoubleClickCommand="{Binding DoubleClickTrayIconCommand}" />

        <!-- LEFT SIDE TRAY MENU -->
        <Border Grid.Column="0" BackgroundColor="{StaticResource Slate900}" StrokeThickness="1" Stroke="{StaticResource Slate700}">
            <Grid RowDefinitions="*, Auto">
                <VerticalStackLayout Spacing="0" Padding="0,30">
                    <Border Style="{StaticResource TabStyle}" AutomationId="Google">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTabClicked" /></Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="G" FontSize="20" FontAttributes="Bold" TextColor="{Binding IsGoogleTab, Converter={StaticResource BoolToColorConverter}, ConverterParameter={StaticResource Emerald500}}" HorizontalOptions="Center" />
                            <Label Text="Antigravity" FontSize="9" FontAttributes="Bold" TextColor="{Binding IsGoogleTab, Converter={StaticResource BoolToColorConverter}, ConverterParameter={StaticResource Slate50}}" HorizontalOptions="Center" />
                            <BoxView HeightRequest="2" WidthRequest="20" BackgroundColor="{StaticResource Emerald500}" IsVisible="{Binding IsGoogleTab}" HorizontalOptions="Center" Margin="0,3,0,0" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource TabStyle}" AutomationId="Codex" Margin="0,10,0,0">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTabClicked" /></Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="C" FontSize="20" FontAttributes="Bold" TextColor="{Binding IsCodexTab, Converter={StaticResource BoolToColorConverter}, ConverterParameter={StaticResource Emerald500}}" HorizontalOptions="Center" />
                            <Label Text="Codex" FontSize="9" FontAttributes="Bold" TextColor="{Binding IsCodexTab, Converter={StaticResource BoolToColorConverter}, ConverterParameter={StaticResource Slate50}}" HorizontalOptions="Center" />
                            <BoxView HeightRequest="2" WidthRequest="20" BackgroundColor="{StaticResource Emerald500}" IsVisible="{Binding IsCodexTab}" HorizontalOptions="Center" Margin="0,3,0,0" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource TabStyle}" AutomationId="Cursor" Margin="0,10,0,0">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTabClicked" /></Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="R" FontSize="20" FontAttributes="Bold" TextColor="{Binding IsCursorTab, Converter={StaticResource BoolToColorConverter}, ConverterParameter={StaticResource Emerald500}}" HorizontalOptions="Center" />
                            <Label Text="Cursor" FontSize="9" FontAttributes="Bold" TextColor="{Binding IsCursorTab, Converter={StaticResource BoolToColorConverter}, ConverterParameter={StaticResource Slate50}}" HorizontalOptions="Center" />
                            <BoxView HeightRequest="2" WidthRequest="20" BackgroundColor="{StaticResource Emerald500}" IsVisible="{Binding IsCursorTab}" HorizontalOptions="Center" Margin="0,3,0,0" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="1" Spacing="0" VerticalOptions="End" Margin="0,0,0,10">
                    <!-- Notifications Button -->
                    <Border Style="{StaticResource TabStyle}" AutomationId="Notifications" Padding="0,12">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTabClicked" /></Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="🔔" FontSize="20" FontAttributes="Bold" TextColor="{Binding IsNotificationsTab, Converter={StaticResource BoolToColorConverter}, ConverterParameter={StaticResource Emerald500}}" HorizontalOptions="Center" />
                            <Label Text="{loc:Loc Key=nav.notifications}" FontSize="9" FontAttributes="Bold" TextColor="{Binding IsNotificationsTab, Converter={StaticResource BoolToColorConverter}, ConverterParameter={StaticResource Slate50}}" HorizontalOptions="Center" />
                            <BoxView HeightRequest="2" WidthRequest="20" BackgroundColor="{StaticResource Emerald500}" IsVisible="{Binding IsNotificationsTab}" HorizontalOptions="Center" Margin="0,3,0,0" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Settings Button -->
                    <Border Style="{StaticResource TabStyle}" AutomationId="Settings" Padding="0,12">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTabClicked" /></Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="⚙" FontSize="20" FontAttributes="Bold" TextColor="{Binding IsSettingsTab, Converter={StaticResource BoolToColorConverter}, ConverterParameter={StaticResource Emerald500}}" HorizontalOptions="Center" />
                            <Label Text="{loc:Loc Key=nav.settings}" FontSize="9" FontAttributes="Bold" TextColor="{Binding IsSettingsTab, Converter={StaticResource BoolToColorConverter}, ConverterParameter={StaticResource Slate50}}" HorizontalOptions="Center" />
                            <BoxView HeightRequest="2" WidthRequest="20" BackgroundColor="{StaticResource Emerald500}" IsVisible="{Binding IsSettingsTab}" HorizontalOptions="Center" Margin="0,3,0,0" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- About Button -->
                    <Border Style="{StaticResource TabStyle}" AutomationId="About" Padding="0,12">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTabClicked" /></Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="?" FontSize="20" FontAttributes="Bold" TextColor="{Binding IsAboutTab, Converter={StaticResource BoolToColorConverter}, ConverterParameter={StaticResource Emerald500}}" HorizontalOptions="Center" />
                            <Label Text="{loc:Loc Key=nav.about}" FontSize="9" FontAttributes="Bold" TextColor="{Binding IsAboutTab, Converter={StaticResource BoolToColorConverter}, ConverterParameter={StaticResource Slate50}}" HorizontalOptions="Center" />
                            <BoxView HeightRequest="2" WidthRequest="20" BackgroundColor="{StaticResource Emerald500}" IsVisible="{Binding IsAboutTab}" HorizontalOptions="Center" Margin="0,3,0,0" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Column="1" RowDefinitions="Auto, Auto, *">
            <!-- Header -->
            <Border Padding="25,15" BackgroundColor="{StaticResource Slate800}" StrokeThickness="0">
                <Border.Shadow><Shadow Brush="Black" Offset="0,2" Radius="5" Opacity="0.2" /></Border.Shadow>
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center" HorizontalOptions="Start">
                        <Image Source="app_logo.png" WidthRequest="174" HeightRequest="38" VerticalOptions="Center" Aspect="AspectFit" />
                        <Label Text="{Binding DisplayVersion}" FontSize="11" TextColor="{StaticResource Slate500}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    
                    <HorizontalStackLayout Grid.Column="2" Spacing="12" VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center" Margin="0,0,15,0">
                            <Label Text="{loc:Loc Key=dashboard.anonymous}" FontSize="10" VerticalOptions="Center" TextColor="{StaticResource Slate400}" />
                            <Border Style="{StaticResource ToggleTrackStyle}" Padding="2" StrokeShape="RoundRectangle 11" WidthRequest="40" HeightRequest="22" ToolTipProperties.Text="{loc:Loc Key=dashboard.anonymous_tooltip}">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnAnonymousToggleClicked" /></Border.GestureRecognizers>
                                <Grid>
                                    <BoxView HorizontalOptions="{Binding ToggleKnobHorizontalOptions}" 
                                             WidthRequest="18" HeightRequest="18" CornerRadius="9" 
                                             Color="{Binding ToggleColor}" />
                                </Grid>
                            </Border>
                        </HorizontalStackLayout>

                        <Button Text="{loc:Loc Key=common.export}" Clicked="OnExportClicked" Style="{StaticResource UtilityButtonStyle}" />
                        <Button Text="{loc:Loc Key=common.import}" Clicked="OnImportClicked" Style="{StaticResource UtilityButtonStyle}" />
                        <Button Text="{Binding AddAccountButtonText}" IsEnabled="{Binding CanAddAccount}" Clicked="OnLoginClicked" Style="{StaticResource PrimaryButtonStyle}" />

                        <Grid WidthRequest="36" HeightRequest="50">
                            <Border Style="{StaticResource IconButtonStyle}" WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 18" ToolTipProperties.Text="{loc:Loc Key=dashboard.refresh_all_tooltip}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRefreshAllClicked" />
                                </Border.GestureRecognizers>
                                <Label Text="↻"
                                   TextColor="{StaticResource Slate100}"
                                   FontSize="22"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Margin="0,0,0,2" />
                            </Border>
                            <Label Text="F5" FontSize="10" TextColor="{StaticResource Slate500}" HorizontalOptions="Center" VerticalOptions="Start" Margin="0,36,0,0" />
                        </Grid>
                    </HorizontalStackLayout>
                </Grid>
            </Border>

            <!-- Stats Board -->
            <Border Grid.Row="1" BackgroundColor="{StaticResource Slate900}" Padding="20,12" StrokeThickness="1" Stroke="{StaticResource Slate700}">
                <HorizontalStackLayout Spacing="40" HorizontalOptions="Center">
                    <VerticalStackLayout>
                        <Label Text="{loc:Loc Key=dashboard.actions}" FontSize="9" FontAttributes="Bold" TextColor="{StaticResource Slate500}" HorizontalOptions="Center" />
                        <Label Text="{Binding GlobalActions}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Slate50}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout>
                        <Label Text="{loc:Loc Key=dashboard.active}" FontSize="9" FontAttributes="Bold" TextColor="{StaticResource Slate500}" HorizontalOptions="Center" />
                        <Label Text="{Binding GlobalActive}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Emerald500}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout>
                        <Label Text="{loc:Loc Key=dashboard.rate_limited}" FontSize="9" FontAttributes="Bold" TextColor="{StaticResource Slate500}" HorizontalOptions="Center" />
                        <Label Text="{Binding GlobalLimited}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Rose500}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout WidthRequest="120">
                        <Label Text="{loc:Loc Key=dashboard.global_quota}" FontSize="9" FontAttributes="Bold" TextColor="{StaticResource Slate500}" HorizontalOptions="Center" />
                        <Label Text="{Binding GlobalQuota, StringFormat='{0}%'}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Slate100}" HorizontalOptions="Center" />
                        <ProgressBar Progress="{Binding GlobalQuota, Converter={StaticResource PercentageConverter}}" HeightRequest="2" ProgressColor="{Binding GlobalQuota, Converter={StaticResource PercentageColorConverter}}" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>

            <!-- Lazily loaded tab view -->
            <ContentView x:Name="TabContentHost" Grid.Row="2" />

            <!-- SHARED Visibility Overlay -->
            <Grid Grid.RowSpan="3" BackgroundColor="#99171f1b" IsVisible="{Binding IsSettingsPanelOpen}">
                <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseSettingsClicked" /></Grid.GestureRecognizers>
                <Border WidthRequest="320" BackgroundColor="{StaticResource Slate800}" Padding="25" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="{StaticResource Slate700}" VerticalOptions="Center" HorizontalOptions="Center">
                    <Border.GestureRecognizers><TapGestureRecognizer /></Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="20" BindingContext="{Binding SelectedAccount}" x:DataType="models:CloudAccount">
                        <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                            <Border HeightRequest="36" WidthRequest="36" StrokeShape="RoundRectangle 18" StrokeThickness="0" BackgroundColor="{StaticResource Slate700}">
                                <Grid>
                                    <Image Source="{Binding AvatarImageSource}" Aspect="AspectFill" IsVisible="{Binding HasAvatarImage}" />
                                    <Label Text="{Binding email, Converter={StaticResource AnonymousAvatarConverter}}" TextColor="{StaticResource Slate100}" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" FontSize="11" IsVisible="{Binding HasAvatarImage, Converter={StaticResource InverseBoolConverter}}" />
                                </Grid>
                            </Border>
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="{Binding name}" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource Slate50}" />
                                <Label Text="{loc:Loc Key=account.model_visibility}" FontSize="9" FontAttributes="Bold" TextColor="{StaticResource Slate500}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <CollectionView ItemsSource="{Binding VisibilityItems}" SelectionMode="None" MaximumHeightRequest="260">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:ModelVisibilityItem">
                                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="15" Padding="0,6" HeightRequest="32">
                                        <CheckBox IsChecked="{Binding IsVisible}" Color="{StaticResource Emerald500}" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding DisplayName}" FontSize="11" TextColor="{StaticResource Slate50}" VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Button Text="{loc:Loc Key=common.save_close}" Clicked="OnCloseSettingsClicked" Style="{StaticResource PrimaryButtonStyle}"
                                HeightRequest="36" Margin="0,15,0,0" />
                    </VerticalStackLayout>
                </Border>
            </Grid>


            <!-- Login Waiting Overlay -->
            <Grid Grid.RowSpan="3" BackgroundColor="#CC171f1b" IsVisible="{Binding IsLoginWaiting}">
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="16">
                    <ActivityIndicator IsRunning="{Binding IsLoginWaiting}" Color="{StaticResource Sky400}" WidthRequest="50" HeightRequest="50" />
                    <Label Text="{loc:Loc Key=login.waiting_title}" TextColor="{StaticResource Slate100}" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" />
                    <Label Text="{loc:Loc Key=login.waiting_detail}" TextColor="{StaticResource Slate400}" FontSize="12" HorizontalOptions="Center" />
                    <Button Text="{loc:Loc Key=login.cancel}" Clicked="OnCancelLoginClicked" Style="{StaticResource UtilityButtonStyle}"
                            HeightRequest="36" Padding="32,0" FontSize="13" Margin="0,8,0,0" />
                </VerticalStackLayout>
            </Grid>

            <!-- CURSOR ID/PW LOGIN WAITING OVERLAY -->
            <Grid Grid.RowSpan="3" BackgroundColor="#CC171f1b" IsVisible="{Binding IsCursorCredentialLoginWaiting}">
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="16">
                    <ActivityIndicator IsRunning="{Binding IsCursorCredentialLoginWaiting}" Color="{StaticResource Emerald500}" WidthRequest="50" HeightRequest="50" />
                    <Label Text="{loc:Loc Key=login.cursor_processing}" TextColor="{StaticResource Slate100}" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" />
                    <Label Text="{loc:Loc Key=login.cursor_processing_detail}" TextColor="{StaticResource Slate400}" FontSize="12" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>

            <!-- CODEX LOGIN OVERLAY (Automated Extraction) -->
            <Grid Grid.RowSpan="3" IsVisible="{Binding IsCodexLoginOverlayVisible}" BackgroundColor="{StaticResource Slate900}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Grid Padding="15" BackgroundColor="{StaticResource Slate800}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="{loc:Loc Key=login.chatgpt_title}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Slate50}"/>
                        <Label Text="{loc:Loc Key=login.chatgpt_detail}" FontSize="12" TextColor="{StaticResource Slate400}"/>
                    </VerticalStackLayout>
                    
                    <Button Grid.Column="1" Text="{loc:Loc Key=common.cancel}" Clicked="OnCancelCodexLoginClicked" Style="{StaticResource UtilityButtonStyle}" />
                </Grid>
                
                <controls:LocalDataWebView x:Name="CodexLoginWebView" Grid.Row="1" Navigated="OnCodexLoginWebViewNavigated" />
            </Grid>

        </Grid>
    </Grid>
</ContentPage>
